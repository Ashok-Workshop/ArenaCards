{
  "name": "arenacards-firebase-tests",
  "private": true,
  "scripts": {
    "test:rules": "firebase --config ../firebase.json emulators:exec --only firestore,auth --project demo-arenacards \"node --test tests/firestore.rules.test.mjs\"",
    "test:functions": "npm --prefix functions test",
    "test:functions:emulator": "firebase --config ../firebase.json emulators:exec --only firestore --project arenacards-f3279 \"npm --prefix functions run test:emulator\""
  },
  "devDependencies": {
    "firebase": "^13.3.0",
    "firebase-tools": "15.36.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "uuid": "11.1.1"
  }
}
